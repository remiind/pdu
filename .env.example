# Kopieren nach .env und anpassen (die .env gehört nicht ins Repo!)

# --- Zugang (nur docker-compose.standalone.yml) ---
PDU_HOST=tmplubuntu26        # Name oder IP, unter der die Oberfläche erreichbar ist
PDU_TLS=internal             # internal = eigene CA (LAN) · oder E-Mail-Adresse für Let's Encrypt
PDU_HTTPS_PORT=8443          # veröffentlichter HTTPS-Port (443 ist auf tmplubuntu26 von Plan belegt)

# --- PDUs ---
# Einträge „Gruppe/Name=Host“, getrennt durch Semikolon. Gruppe ist optional (Überschrift in der Auswahl).
PDU_LIST=Labor/PDU Labor 1=192.0.2.21; Labor/PDU Labor 2=192.0.2.22; Prestaging/PDU Prestaging 1=192.0.2.31; Prestaging/PDU Prestaging 2=192.0.2.32
PDU_USER=apiuser
PDU_PASSWORD=
PDU_VERIFY_TLS=0             # 1 = Zertifikat der PDUs prüfen (Standard aus: selbstsigniert)
# PDU_CACHE_SECONDS=2        # so lange werden Messwerte zwischengespeichert
